{
  "name": "@medea/engine-nodes-stdlib-sandbox",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./bundle": {
      "import": "./dist/sandbox-bundle.js"
    },
    "./bundle-source": {
      "import": "./dist/sandbox-bundle-source.js",
      "types": "./dist/sandbox-bundle-source.d.ts"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && pnpm run bundle",
    "lint": "eslint src",
    "bundle": "node scripts/build-sandbox-bundle.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run -c vitest.config.ts",
    "test:fast": "vitest run -c vitest.config.ts"
  },
  "devDependencies": {
    "@medea/engine-eslint-config": "workspace:*",
    "esbuild": "^0.24.0",
    "eslint": "^9.39.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.9"
  }
}
