{
  "name": "@medea/engine-nodes-stdlib",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm run typecheck && vitest run -c vitest.config.ts",
    "test:fast": "vitest run -c vitest.config.ts",
    "test:e2e": "vitest run -c vitest.e2e.config.ts",
    "lint": "eslint src --max-warnings 0"
  },
  "dependencies": {
    "@medea/engine-core-schema": "workspace:*",
    "@medea/engine-safe-fetch": "workspace:*",
    "@medea/engine-shared": "workspace:*",
    "cheerio": "^1.2.0",
    "re2": "^1.25.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@medea/engine-eslint-config": "workspace:*",
    "@medea/engine-tsconfig": "workspace:*",
    "eslint": "^9.39.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0",
    "@vitest/coverage-v8": "^3.0.0"
  }
}
