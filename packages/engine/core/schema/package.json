{
  "name": "@medea/engine-core-schema",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./nodes": {
      "types": "./dist/nodes.d.ts",
      "import": "./dist/nodes.js"
    },
    "./workflow": {
      "types": "./dist/workflow.d.ts",
      "import": "./dist/workflow.js"
    },
    "./runs": {
      "types": "./dist/runs.d.ts",
      "import": "./dist/runs.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "eslint src"
  },
  "dependencies": {
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@medea/engine-eslint-config": "workspace:*",
    "@medea/engine-tsconfig": "workspace:*",
    "@vitest/coverage-v8": "^3.0.0",
    "eslint": "^9.39.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
