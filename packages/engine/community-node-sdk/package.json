{
  "name": "@medea/engine-community-node-sdk",
  "version": "1.0.0",
  "description": "Type-safe builder + CLI for FlowForge community-node (.ffnode) packages",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "ffnode-build": "./dist/bin/ffnode-build.js",
    "ffnode-test": "./dist/bin/ffnode-test.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint src",
    "test": "vitest run"
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@medea/engine-eslint-config": "workspace:*",
    "@medea/engine-tsconfig": "workspace:*",
    "@types/adm-zip": "^0.5.7",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^3.0.0",
    "eslint": "^9.39.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
