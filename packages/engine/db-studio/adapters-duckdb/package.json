  },
  "devDependencies": {
    "@medea/engine-eslint-config": "workspace:*",
    "@medea/engine-tsconfig": "workspace:*",
    "@vitest/coverage-v8": "^3.0.0",
    "eslint": "^9.39.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
