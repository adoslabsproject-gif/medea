{
  "font": {
    "family": {
      "sans": "'Inter Variable', 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', system-ui, sans-serif",
      "mono": "'JetBrains Mono Variable', 'JetBrains Mono', 'SF Mono', 'Fira Code', Menlo, Consolas, monospace",
      "serif": "'Source Serif Variable', Georgia, 'Times New Roman', serif"
    },
    "size": {
      "$comment": "clamp(min, fluid, max) — fluid type su viewport. Niente px fissi. Scala alzata il 2026-08-03 di circa un punto per gradino: il testo dell'interfaccia partiva da 11px e su uno schermo grande si leggeva stretto.",
      "xs": "clamp(0.75rem,   0.05vw + 0.74rem, 0.8125rem)",
      "sm": "clamp(0.8125rem, 0.10vw + 0.79rem, 0.9375rem)",
      "md": "clamp(0.9375rem, 0.15vw + 0.91rem, 1.0625rem)",
      "lg": "clamp(1.0625rem, 0.20vw + 1.02rem, 1.1875rem)",
      "xl": "clamp(1.1875rem, 0.30vw + 1.13rem, 1.375rem)",
      "2xl": "clamp(1.375rem,  0.50vw + 1.27rem, 1.625rem)",
      "3xl": "clamp(1.625rem,  0.80vw + 1.47rem, 2rem)",
      "4xl": "clamp(2rem,      1.20vw + 1.78rem, 2.625rem)"
    },
    "weight": {
      "regular": "400",
      "medium": "500",
      "semibold": "600",
      "bold": "700"
    },
    "leading": {
      "tight": "1.2",
      "snug": "1.35",
      "normal": "1.5",
      "relaxed": "1.65"
    },
    "tracking": {
      "tight": "-0.01em",
      "normal": "0",
      "wide": "0.04em",
      "wider": "0.08em"
    }
  }
}
