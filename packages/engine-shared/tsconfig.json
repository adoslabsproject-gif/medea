{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@medea/engine-tsconfig/node.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    // Il preset condiviso accende `incremental`. Qui il pacchetto lo costruisce
    // con tsup, che per i .d.ts invoca tsc per conto suo: senza un percorso
    // esplicito per il file di stato, quella chiamata muore con TS5074.
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.tsbuildinfo"
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
