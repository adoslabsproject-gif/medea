{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "Medea React (DOM)",
  "extends": "./base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "allowJs": false,
    "useDefineForClassFields": true,
    "types": ["vite/client"]
  }
}
